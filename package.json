{
  "name": "@chromvoid/headless-ui",
  "version": "0.2.0",
  "description": "Headless interaction and accessibility contracts for future UI kit",
  "keywords": [
    "a11y",
    "apg",
    "headless",
    "reatom"
  ],
  "homepage": "https://github.com/chromvoid/headless-ui#readme",
  "bugs": {
    "url": "https://github.com/chromvoid/headless-ui/issues"
  },
  "license": "MIT",
  "author": "ChromVoid Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chromvoid/headless-ui.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "specs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js",
      "default": "./dist/core/*.js"
    },
    "./interactions/*": {
      "types": "./dist/interactions/*.d.ts",
      "import": "./dist/interactions/*.js",
      "default": "./dist/interactions/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsc -p tsconfig.build.json && bun ./scripts/postbuild.mjs",
    "check:bundle": "bun run build && bun ./scripts/check-bundle-contract.mjs",
    "check:exports": "bun run build && bun ./scripts/check-package-exports.mjs",
    "check:pack": "bun pm pack --dry-run",
    "format": "bunx oxfmt --write README.md package.json tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json src scripts specs",
    "lint": "bun run lint:types && bun run lint:oxlint && bun run lint:format && bun run lint:boundaries",
    "lint:boundaries": "bun ./scripts/check-standalone-boundaries.mjs",
    "lint:format": "bunx oxfmt --check README.md package.json tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json src scripts specs",
    "lint:oxlint": "bunx oxlint --config ./.oxlintrc.json src scripts vitest.config.ts",
    "lint:release-governance": "bun ./scripts/check-release-governance.mjs",
    "lint:types": "bunx tsc --noEmit -p tsconfig.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun run lint && bun run test && bun run check:pack",
    "release:changelog": "bun ./scripts/generate-changelog.mjs --mode full --out ./specs/release/changelog.generated.md && bunx oxfmt --write ./specs/release/changelog.generated.md",
    "release:changelog:patch": "bun ./scripts/generate-changelog.mjs --mode patch --out ./specs/release/changelog.patch.generated.md && bunx oxfmt --write ./specs/release/changelog.patch.generated.md",
    "test": "bun run test:unit && bun run check:exports && bun run check:bundle",
    "test:unit": "bunx vitest run --config ./vitest.config.ts",
    "test:watch": "bunx vitest --config ./vitest.config.ts --watch"
  },
  "dependencies": {
    "@reatom/core": "^1001.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "esbuild": "^0.27.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.51.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.10"
}
